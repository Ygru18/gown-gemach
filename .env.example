# Copy to .env for local development. Never commit the filled-in file.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Postgres via Supabase's transaction pooler (port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Postgres via Supabase's session pooler (port 5432). Used only by the Prisma CLI
# (`prisma migrate deploy`, run automatically during each Vercel build).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project URL and publishable/anon key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Supabase "secret" (service_role) key.
# Used only to sign photo URLs and to create/disable staff logins.
SUPABASE_SERVICE_ROLE_KEY="<secret-or-service-role-key>"

# Private Storage bucket for gown photographs.
SUPABASE_STORAGE_BUCKET="gown-photos"

# One-time code that protects the first-run /setup page (create the first admin).
# Once an administrator exists, /setup is permanently disabled; you may delete this.
SETUP_TOKEN="<long-random-string>"

# --- Local development only --------------------------------------------------
# E2E_LOCAL_MODE=1 swaps Supabase Auth/Storage for a local cookie + folder so the
# whole app can run against a local Postgres. It only works under `next dev`
# outside Vercel; it can never activate on a deployed site.
# E2E_LOCAL_MODE="1"
